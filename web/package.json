    "@vue-email/render": "^0.0.9",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
