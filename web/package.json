    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
