{
  "name": "@clientshare/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p \"build-only {@}\" --",
    "build:emails": "vite-node --config ./scripts/vite.config.emails.ts ./scripts/build-email-templates.ts",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@embedpdf/vue-pdf-viewer": "^2.15.1",
    "@openvue/openicons": "^1.0.0",
    "@openvue/themes": "^1.0.0",
